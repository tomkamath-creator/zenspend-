{
  "expo": {
    "name": "SereneSpend by VK",
    "slug": "serenespend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8F5"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SereneSpend uses your camera strictly offline to photograph receipts and bills.",
        "NSPhotoLibraryUsageDescription": "SereneSpend accesses your gallery strictly offline to scan receipt screenshots."
      }
    },
    "android": {
      "package": "com.serenespend.offlinetracker",
      "adaptiveIcon": {
        "backgroundColor": "#F6F8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidSigning",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SereneSpend accesses your photos strictly offline to attach receipt screenshots.",
          "cameraPermission": "SereneSpend uses your camera strictly offline to photograph paper bills."
        }
      ]
    ]
  }
}
